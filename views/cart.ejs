<%- include('partials/header', { title: 'Your Cart' }) %>
<script src="https://www.paypal.com/sdk/js?client-id=<%= process.env.PAYPAL_CLIENT_ID %>&currency=SGD"></script>
<%- include('partials/navbar', { user: locals.user }) %>


  <div class="container">
    <div class="content-card">
      <div class="section-heading mb-3">
        <div>
          <p class="eyebrow mb-1">Cart</p>
          <h2 class="mb-0">Your picks</h2>
        </div>
        <a href="/shopping" class="btn btn-light btn-sm">Back to shopping</a>
      </div>

      <% if (messages && messages.length) { %>
        <div class="alert alert-success"><%= messages[0] %></div>
      <% } %>
      <% if (errors && errors.length) { %>
        <div class="alert alert-danger"><%= errors[0] %></div>
      <% } %>

      <% if (cart.length === 0) { %>
        <div class="empty-state">Your cart is empty.</div>
      <% } else { %>
        <div class="table-responsive table-card">
          <table class="table table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>Product</th>
                <th>Image</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% let total = Number(cartTotal || 0); %>
              <% for (let i = 0; i < cart.length; i++) { %>
                <tr>
                    <td><%= cart[i].productName %></td>
                    <td><img src="/images/<%= cart[i].image %>" width="80" class="img-thumbnail"></td>
                    <td>S$<%= cart[i].price.toFixed(2) %></td>
                    <td>
                      <form action="/cart/update/<%= cart[i].id %>" method="POST" class="d-flex align-items-center gap-2">
                        <input type="number" name="quantity" value="<%= cart[i].quantity %>" min="1" class="form-control form-control-sm" style="width: 90px;">
                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                      </form>
                    </td>
                    <td>S$<%= (cart[i].price * cart[i].quantity).toFixed(2) %></td>
                    <td>
                      <form action="/cart/remove/<%= cart[i].id %>" method="POST">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                      </form>
                    </td>
                </tr>
              <% }; %>
            </tbody>
          </table>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-start mt-3 gap-3">
          <div>
            <form id="promo-form" class="d-flex flex-wrap gap-2 align-items-center">
              <input type="hidden" id="cart-subtotal" value="<%= total.toFixed(2) %>">
              <input type="text" name="promoCode" id="promoCode" placeholder="Promo code" class="form-control" style="width:200px;">
              <button type="submit" class="btn btn-outline-info">Apply Code</button>
            </form>
            <div id="promo-result" class="mt-2 small text-muted"></div>
            <% const discountValue = Number(discountAmount || 0); %>
            <% const discountedTotal = Number(Math.max(0, total - discountValue).toFixed(2)); %>
            <div id="promo-totals" class="mt-2 small text-muted">
              S$<span id="promo-discount"><%= discountValue.toFixed(2) %></span> deducted.
              <input type="hidden" id="promo-total" value="<%= discountedTotal.toFixed(2) %>">
              <input type="hidden" id="promo-subtotal" value="<%= total.toFixed(2) %>">
            </div>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <div class="d-flex flex-column" data-wallet-applied="<%= Number(walletApplied || 0).toFixed(2) %>">
              <h4 class="mb-1">Total: S$<span id="cart-total"><%= total.toFixed(2) %></span></h4>
              <div class="small text-muted">Discount applied: S$<span id="discount-applied"><%= discountValue.toFixed(2) %></span></div>
              <% if (walletApplied && walletApplied > 0) { %>
                <div class="small text-muted">Wallet applied: S$<span id="wallet-applied"><%= walletApplied.toFixed(2) %></span></div>
                <div class="small text-muted">Payable: S$<span id="payable-total"><%= payableTotal.toFixed(2) %></span></div>
              <% } %>
            </div>
            <form action="/cart/clear" method="POST" class="d-inline">
              <button type="submit" class="btn btn-light">Clear Cart</button>
            </form>
          </div>
          <div class="row g-3 mt-3">
              <div class="col-12 col-md-4">
                <div class="surface p-3 h-100">
                  <h6 class="mb-2">Wallet</h6>
                  <div class="small text-muted">Balance: S$<%= (walletBalance || 0).toFixed(2) %></div>
                  <form action="/wallet/apply" method="POST" class="d-flex gap-2 align-items-center mt-2">
                    <input type="number" name="amount" class="form-control form-control-sm" step="0.01" min="0.01" max="<%= Math.min(walletBalance || 0, discountedTotal).toFixed(2) %>" placeholder="Amount">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Apply</button>
                  </form>
                <% if (walletApplied && walletApplied > 0) { %>
                  <form action="/wallet/remove" method="POST" class="mt-2">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Remove wallet</button>
                  </form>
                <% } %>
                <% if (walletBalance && walletBalance >= discountedTotal && discountedTotal > 0) { %>
                  <form action="/wallet/checkout" method="POST" class="mt-2">
                    <button type="submit" class="btn btn-sm btn-success w-100">Pay with Wallet</button>
                  </form>
                <% } %>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="surface p-3 h-100">
                <h6 class="mb-2">PayPal</h6>
                <div id="paypal-button-container"></div>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="surface p-3 h-100">
                <h6 class="mb-2">NETS QR</h6>
                <form action="/generateNETSQR" method="POST">
                  <button type="submit" class="btn btn-success w-100">Pay with NETS QR</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

<%- include('partials/footer') %>

<script>
  const form = document.getElementById('promo-form');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('promoCode').value;
      const subtotal = document.getElementById('cart-subtotal').value;
      const resultEl = document.getElementById('promo-result');
      const totalEl = document.getElementById('cart-total');
      const discountAppliedEl = document.getElementById('discount-applied');
      const walletAppliedEl = document.getElementById('wallet-applied');
      const payableEl = document.getElementById('payable-total');
      const walletAppliedValue = parseFloat(document.querySelector('[data-wallet-applied]')?.dataset.walletApplied || '0') || 0;
      resultEl.textContent = 'Applying...';
      try {
        const res = await fetch('/cart/apply-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ promoCode: code, subtotal })
        });
        const data = await res.json();
        if (!data.success) {
          resultEl.textContent = data.message || 'Invalid code.';
          document.getElementById('promo-discount').textContent = '0.00';
          document.getElementById('promo-total').value = parseFloat(subtotal).toFixed(2);
          if (totalEl) totalEl.textContent = parseFloat(subtotal).toFixed(2);
          if (discountAppliedEl) discountAppliedEl.textContent = '0.00';
          if (walletAppliedEl && payableEl) {
            const payable = Math.max(0, parseFloat(subtotal) - walletAppliedValue);
            payableEl.textContent = payable.toFixed(2);
          }
          return;
        }
        resultEl.textContent = data.message;
        document.getElementById('promo-discount').textContent = Number(data.discount).toFixed(2);
        document.getElementById('promo-total').value = Number(data.total).toFixed(2);
        if (totalEl) totalEl.textContent = parseFloat(subtotal).toFixed(2);
        if (discountAppliedEl) discountAppliedEl.textContent = Number(data.discount).toFixed(2);
        if (walletAppliedEl && payableEl) {
          const payable = Math.max(0, Number(data.total) - walletAppliedValue);
          payableEl.textContent = payable.toFixed(2);
        }
      } catch (err) {
        resultEl.textContent = 'Error applying code.';
      }
    });
  }
</script>
<script>
  const paypalContainer = document.getElementById('paypal-button-container');
  const cartHasItems = <%= cart.length %> > 0;
  if (!cartHasItems && paypalContainer) {
    paypalContainer.style.display = 'none';
  }
  if (cartHasItems && paypalContainer) {
    paypal.Buttons({
      createOrder: function () {
        return fetch('/api/paypal/create-order', {
          method: 'post',
          headers: { 'content-type': 'application/json' }
        }).then(res => res.json()).then(data => data.id);
      },
      onApprove: function (data) {
        return fetch('/api/paypal/capture-order', {
          method: 'post',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ orderID: data.orderID })
        }).then(res => res.json()).then(details => {
          if (details.success) {
            window.location.href = '/invoice';
          } else {
            alert(details.error || 'Payment not completed.');
          }
        });
      }
    }).render('#paypal-button-container');
  }
</script>
