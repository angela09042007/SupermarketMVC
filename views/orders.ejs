<%- include('partials/header', { title: 'My Orders' }) %>
<%- include('partials/navbar', { user: locals.user }) %>

<div class="container">
    <div class="content-card">
        <header class="mb-3 section-heading">
            <div>
                <p class="eyebrow mb-1">Orders</p>
                <h2 class="mb-0"><%= user && user.role === 'admin' ? 'All orders' : 'My orders' %></h2>
            </div>
            <a href="/shopping" class="btn btn-light btn-sm">Back to shopping</a>
        </header>

        <%- include('partials/search', { action: '/orders', placeholder: 'Search orders or products...', searchTerm: (typeof searchTerm !== 'undefined' ? searchTerm : '') }) %>

        <% if (errors && errors.length) { %>
            <div class="alert alert-danger">
                <% errors.forEach(function(err){ %><p class="mb-0"><%= err %></p><% }); %>
            </div>
        <% } %>
        <% if (messages && messages.length) { %>
            <div class="alert alert-success">
                <% messages.forEach(function(msg){ %><p class="mb-0"><%= msg %></p><% }); %>
            </div>
        <% } %>

        <% if (!orders || orders.length === 0) { %>
            <div class="empty-state">No orders found.</div>
        <% } else { %>
            <div class="d-flex flex-column gap-3">
                <% orders.forEach(function(order){ %>
                    <% const orderHasActiveRefund = order.items.some(item => item.refundStatus && item.refundStatus !== 'rejected'); %>
                    <% const pendingRefundCount = order.items.filter(item => item.refundStatus === 'pending').length; %>
                    <% const isFullOrderRefundPending = pendingRefundCount > 0 && pendingRefundCount === order.items.length; %>
                    <% const discountAmount = order.discount ? Number(order.discount.amount) : 0; %>
                    <% const paymentSummary = order.paymentSummary || { wallet: 0, paypal: 0, nets: 0 }; %>
                    <section class="surface" id="order-<%= order.id %>">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0">Order #<%= order.id %></h5>
                            <span class="muted small"><%= new Date(order.createdAt).toLocaleString() %></span>
                        </div>
                        <% if (user && user.role === 'admin') { %>
                            <p class="text-muted mb-3 small">User ID: <%= order.userId %></p>
                            <% if (isFullOrderRefundPending) { %>
                                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center mb-3">
                                    <span class="small text-muted">Full order refund request pending.</span>
                                    <form action="/admin/refunds/order/<%= order.id %>/approve" method="POST">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Approve full order</button>
                                    </form>
                                    <form action="/admin/refunds/order/<%= order.id %>/reject" method="POST">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject full order</button>
                                    </form>
                                </div>
                            <% } %>
                        <% } else if (orderHasActiveRefund) { %>
                            <p class="text-muted mb-3 small">Refund request already submitted for this order.</p>
                        <% } else { %>
                            <form action="/orders/refund-order/<%= order.id %>" method="POST" class="d-flex flex-column flex-md-row gap-2 align-items-md-center mb-3">
                                <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason for full order refund" maxlength="255" required>
                                <button type="submit" class="btn btn-sm btn-outline-warning">Request full order refund</button>
                            </form>
                        <% } %>
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mb-2">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>Price</th>
                                        <th>Subtotal</th>
                                        <th>Refund</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% order.items.forEach(function(item){ %>
                                        <tr>
                                            <td>
                                                <% if (item.image) { %>
                                                    <img src="/images/<%= item.image %>" alt="<%= item.productName %>" style="height:30px;vertical-align:middle;margin-right:8px;">
                                                <% } %>
                                                <%= item.productName %>
                                            </td>
                                            <td><%= item.quantity %></td>
                                            <td>S$<%= item.price.toFixed(2) %></td>
                                            <td>S$<%= (item.price * item.quantity).toFixed(2) %></td>
                                            <td>
                                                <% if (item.refundStatus) { %>
                                                    <div class="small text-muted">Status: <%= item.refundStatus %></div>
                                                    <% if (item.refundReason) { %>
                                                        <div class="small text-muted">Reason: <%= item.refundReason %></div>
                                                    <% } %>
                                                    <% if (item.refundAmount) { %>
                                                        <div class="small text-muted">Amount: S$<%= Number(item.refundAmount).toFixed(2) %></div>
                                                    <% if (item.refundBreakdown) { %>
                                                        <% if (item.refundBreakdown.wallet && item.refundBreakdown.wallet > 0) { %>
                                                            <div class="small text-muted">Refund to wallet (incl. NETS): S$<%= item.refundBreakdown.wallet.toFixed(2) %></div>
                                                        <% } %>
                                                        <% if (item.refundBreakdown.paypal && item.refundBreakdown.paypal > 0) { %>
                                                            <div class="small text-muted">Refund to PayPal: S$<%= item.refundBreakdown.paypal.toFixed(2) %></div>
                                                        <% } %>
                                                    <% } else if (item.refundPaymentMethod) { %>
                                                        <div class="small text-muted">Refund method: <%= item.refundPaymentMethod %></div>
                                                    <% } %>
                                                    <% } %>
                                                    <% if (user && user.role === 'admin' && item.refundStatus === 'pending' && item.refundId && !isFullOrderRefundPending) { %>
                                                        <div class="d-flex flex-column gap-2 mt-1">
                                                            <form action="/admin/refunds/<%= item.refundId %>/approve" method="POST" class="d-flex gap-2 align-items-center">
                                                                <input type="number" name="amount" class="form-control form-control-sm" step="0.01" min="0.01" max="<%= (item.price * item.quantity).toFixed(2) %>" value="<%= (item.price * item.quantity).toFixed(2) %>" style="max-width: 130px;">
                                                                <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                                            </form>
                                                            <form action="/admin/refunds/<%= item.refundId %>/reject" method="POST">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                                            </form>
                                                        </div>
                                                    <% } %>
                                                <% } else if (user && user.role !== 'admin' && !orderHasActiveRefund) { %>
                                                    <form action="/orders/refund/<%= item.id %>" method="POST" class="d-flex flex-column gap-1">
                                                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="Refund reason" maxlength="255" required>
                                                        <button type="submit" class="btn btn-sm btn-outline-warning">Request refund</button>
                                                    </form>
                                                <% } else { %>
                                                    <span class="text-muted small">-</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Subtotal</th>
                                        <th>S$<%= order.total.toFixed(2) %></th>
                                    </tr>
                                    <% if (discountAmount > 0) { %>
                                        <tr>
                                            <th colspan="3" class="text-end">Discount</th>
                                            <th>-S$<%= discountAmount.toFixed(2) %></th>
                                        </tr>
                                    <% } %>
                                    <% if (paymentSummary.wallet > 0) { %>
                                        <tr>
                                            <th colspan="3" class="text-end">Paid by Wallet</th>
                                            <th>S$<%= paymentSummary.wallet.toFixed(2) %></th>
                                        </tr>
                                    <% } %>
                                    <% if (paymentSummary.paypal > 0) { %>
                                        <tr>
                                            <th colspan="3" class="text-end">Paid by PayPal</th>
                                            <th>S$<%= paymentSummary.paypal.toFixed(2) %></th>
                                        </tr>
                                    <% } %>
                                    <% if (paymentSummary.nets > 0) { %>
                                        <tr>
                                            <th colspan="3" class="text-end">Paid by NETS</th>
                                            <th>S$<%= paymentSummary.nets.toFixed(2) %></th>
                                        </tr>
                                    <% } %>
                                    <tr>
                                        <th colspan="3" class="text-end">Total paid</th>
                                        <th>S$<%= (order.netTotal || order.total).toFixed(2) %></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </section>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
