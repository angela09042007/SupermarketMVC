<%- include('partials/header', { title: title || 'NETS QR Error' }) %>
<%- include('partials/navbar', { user: locals.user }) %>

<div class="container">
  <div class="content-card">
    <div class="section-heading mb-3">
      <div>
        <p class="eyebrow mb-1">NETS QR</p>
        <h2 class="mb-0">Payment error</h2>
      </div>
      <a href="/cart" class="btn btn-light btn-sm">Back to cart</a>
    </div>

    <div class="alert alert-danger mb-3">
      <%= errorMsg %>
    </div>

    <div class="small text-muted">
      Response code: <%= responseCode %>
      <% if (instructions) { %>
        <div class="mt-1">Instructions: <%= instructions %></div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
