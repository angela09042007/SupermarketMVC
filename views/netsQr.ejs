<%- include('partials/header', { title: title || 'NETS QR Payment' }) %>
<%- include('partials/navbar', { user: locals.user }) %>

<div class="container">
  <div class="content-card">
    <div class="section-heading mb-3">
      <div>
        <p class="eyebrow mb-1">NETS QR</p>
        <h2 class="mb-0">Scan to pay</h2>
      </div>
      <a href="<%= backUrl || '/cart' %>" class="btn btn-light btn-sm">Back</a>
    </div>

    <div class="row g-4 align-items-center">
      <div class="col-lg-6 text-center">
        <img src="<%= qrCodeUrl %>" alt="NETS QR Code" class="img-fluid" style="max-width: 320px;">
      </div>
      <div class="col-lg-6">
        <p class="mb-2">Amount due: <strong>S$<%= total %></strong></p>
        <p id="status" class="mb-2">Scan with your bank app to complete payment.</p>
        <p id="timer" class="text-muted mb-3">Time remaining: 5:00</p>
        <p class="small text-muted mb-0">Do not close this page until payment is complete.</p>
      </div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/event-source-polyfill"></script>
<script>
  let s2sNetsTxnStatus;
  if (s2sNetsTxnStatus) {
    s2sNetsTxnStatus.close();
  }

  const txnRetrievalRef = "<%= txnRetrievalRef %>";
  const url = `/sse/payment-status/${txnRetrievalRef}`;
  const successUrl = "<%= successUrl || '/nets-qr/success' %>";
  const failUrl = "<%= failUrl || '/nets-qr/fail' %>";

  s2sNetsTxnStatus = new EventSourcePolyfill(url, {
    heartbeatTimeout: 150000
  });

  s2sNetsTxnStatus.addEventListener("message", (event) => {
    const data = JSON.parse(event.data);

    if (data.success) {
      if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
      window.location.href = `${successUrl}?txn_retrieval_ref=${encodeURIComponent(txnRetrievalRef)}`;
    } else if (data.fail) {
      if (s2sNetsTxnStatus) s2sNetsTxnStatus.close();
      window.location.href = `${failUrl}?txn_retrieval_ref=${encodeURIComponent(txnRetrievalRef)}`;
    }
  });

  const timerElement = document.getElementById("timer");
  const countdownDuration = <%= timer || 300 %>;
  let remainingTime = countdownDuration;

  const updateTimer = () => {
    const minutes = Math.floor(remainingTime / 60);
    const seconds = remainingTime % 60;
    timerElement.textContent = `Time remaining: ${minutes}:${seconds.toString().padStart(2, "0")}`;
    remainingTime -= 1;

    if (remainingTime < 0) {
      clearInterval(timerInterval);
      timerElement.textContent = "Transaction timed out.";
      if (s2sNetsTxnStatus) {
        s2sNetsTxnStatus.close();
      }
      window.location.href = `${failUrl}?txn_retrieval_ref=${encodeURIComponent(txnRetrievalRef)}`;
    }
  };

  const timerInterval = setInterval(updateTimer, 1000);
  updateTimer();
</script>

<%- include('partials/footer') %>
